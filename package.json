    "truncateTo",
    "randomInt",
    "inRange",
    "average",
    "normalize",
    "toOrdinal",
    "toRoman",
    "formatNumber",
    "formatBytes",
    "formatDuration",
    "timeAgo",
    "formatDate",
    "daysBetween",
    "addDays",
    "addMonths",
    "addYears",
    "startOfDay",
    "endOfDay",
    "startOfWeek",
    "startOfMonth",
    "isSameDay",
    "isToday",
    "isWeekend",
    "slugify",
    "camelCase",
    "snakeCase",
    "kebabCase",
    "pascalCase",
    "titleCase",
    "capitalize",
    "truncate",
    "excerpt",
    "escapeHtml",
    "template",
    "mask",
    "randomId",
    "array",
    "object",
    "date",
    "async",
    "string",
    "number",
    "fn",
    "game-dev",
    "animation",
    "node",
    "browser"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "object": [
        "./dist/object/index.d.ts"
      ],
      "array": [
        "./dist/array/index.d.ts"
      ],
      "date": [
        "./dist/date/index.d.ts"
      ],
      "async": [
        "./dist/async/index.d.ts"
      ],
      "string": [
        "./dist/string/index.d.ts"
      ],
      "number": [
        "./dist/number/index.d.ts"
      ],
      "delay": [
        "./dist/delay/index.d.ts"
      ],
      "fn": [
        "./dist/fn/index.d.ts"
      ],
      "emitter": [
        "./dist/emitter/index.d.ts"
      ],
      "encode": [
        "./dist/encode/index.d.ts"
      ],
      "validate": [
        "./dist/validate/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./object": {
      "import": {
        "types": "./dist/object/index.d.ts",
        "default": "./dist/object/index.js"
      },
      "require": {
        "types": "./dist/object/index.d.cts",
        "default": "./dist/object/index.cjs"
      }
    },
    "./array": {
