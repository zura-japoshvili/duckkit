{
  "name": "duckkit",
  "version": "0.2.0",
  "description": "TypeScript-first utility library. Zero dependencies, tree-shakeable, fully typed. Typed groupBy, safe/Result type, pipe, pipeline, compose, curry, typed event emitter, delaySkippable, and more.",
  "author": "Zura Japoshvili",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zura-japoshvili/duckkit.git"
  },
  "keywords": [
    "typescript",
    "javascript",
    "utility",
    "utils",
    "helpers",
    "toolkit",
    "functional",
    "tree-shakeable",
    "tree-shaking",
    "zero-dependencies",
    "zero-deps",
    "esm",
    "cjs",
    "dual-build",
    "type-safe",
    "typed",
    "lodash-alternative",
    "ramda-alternative",
    "underscore-alternative",
    "date-fns-alternative",
    "radash-alternative",
    "groupBy",
    "flatGroupBy",
    "topBy",
    "sortBy",
    "partition",
    "chunk",
    "compact",
    "shuffle",
    "flatten",
    "range",
    "unique",
    "zip",
    "union",
    "intersection",
    "difference",
    "countBy",
    "keyBy",
    "sum",
    "sumBy",
    "pick",
    "omit",
    "deepClone",
