    "mapKeys",
    "mapValues",
    "invertObject",
    "flattenObject",
    "filterKeys",
    "filterValues",
    "pipe",
    "pipeline",
    "compose",
    "pipelineAsync",
    "composeAsync",
    "curry",
    "tap",
    "when",
    "partial-application",
    "function-composition",
    "safe",
    "safeAsync",
    "result",
    "result-type",
    "error-handling",
    "debounce",
    "throttle",
    "memo",
    "memoize",
    "memoAsync",
    "retry",
    "timeout",
    "once",
    "defer",
    "parallel",
    "sequential",
    "concurrency",
    "event-emitter",
