        "default": "./dist/array/index.js"
      },
      "require": {
        "types": "./dist/array/index.d.cts",
        "default": "./dist/array/index.cjs"
      }
    },
    "./date": {
      "import": {
        "types": "./dist/date/index.d.ts",
        "default": "./dist/date/index.js"
      },
      "require": {
        "types": "./dist/date/index.d.cts",
        "default": "./dist/date/index.cjs"
      }
    },
    "./async": {
      "import": {
        "types": "./dist/async/index.d.ts",
        "default": "./dist/async/index.js"
      },
      "require": {
        "types": "./dist/async/index.d.cts",
        "default": "./dist/async/index.cjs"
      }
    },
    "./string": {
      "import": {
        "types": "./dist/string/index.d.ts",
        "default": "./dist/string/index.js"
      },
      "require": {
        "types": "./dist/string/index.d.cts",
        "default": "./dist/string/index.cjs"
      }
    },
    "./number": {
      "import": {
        "types": "./dist/number/index.d.ts",
        "default": "./dist/number/index.js"
      },
      "require": {
        "types": "./dist/number/index.d.cts",
        "default": "./dist/number/index.cjs"
      }
    },
    "./delay": {
      "import": {
        "types": "./dist/delay/index.d.ts",
        "default": "./dist/delay/index.js"
      },
      "require": {
        "types": "./dist/delay/index.d.cts",
        "default": "./dist/delay/index.cjs"
      }
    },
    "./fn": {
      "import": {
        "types": "./dist/fn/index.d.ts",
