        "default": "./dist/fn/index.cjs"
      }
    },
    "./emitter": {
      "import": {
        "types": "./dist/emitter/index.d.ts",
        "default": "./dist/emitter/index.js"
      },
      "require": {
        "types": "./dist/emitter/index.d.cts",
        "default": "./dist/emitter/index.cjs"
      }
    },
    "./encode": {
      "import": {
        "types": "./dist/encode/index.d.ts",
        "default": "./dist/encode/index.js"
      },
      "require": {
        "types": "./dist/encode/index.d.cts",
        "default": "./dist/encode/index.cjs"
      }
    },
    "./validate": {
      "import": {
        "types": "./dist/validate/index.d.ts",
        "default": "./dist/validate/index.js"
      },
      "require": {
        "types": "./dist/validate/index.d.cts",
        "default": "./dist/validate/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:timezones": "TZ=Australia/Sydney vitest run tests/timezone.test.ts && TZ=America/Asuncion vitest run tests/timezone.test.ts && TZ=America/New_York vitest run tests/timezone.test.ts",
    "lint": "tsc --noEmit && tsc -p tsconfig.test.json",
    "check:package": "node scripts/check-package.mjs && publint --strict && attw --pack .",
    "prepublishOnly": "npm run build && npm run check:package"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "publint": "^0.3.25",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
